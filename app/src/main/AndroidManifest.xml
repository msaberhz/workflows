<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required for VPN tunnel communication and network health probes -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required to monitor Wi-Fi and Cellular network states via ConnectivityManager -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Required to request simultaneous Cellular network alongside Wi-Fi -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- Required to inspect Wi-Fi link metadata (RSSI, frequency) -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Required to keep VPN / Smart Monitor alive as a visible Foreground Service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Required on Android 13+ to display VPN status notification -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Optional: auto-connect after device boot when user enables Auto-Connect -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Allows guiding user to battery optimization whitelist for uninterrupted VPN -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".NetFusionApp"
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NetFusion"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".vpn.NetFusionVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn_connection_bonding" />
        </service>

        <receiver
            android:name=".vpn.BootCompletedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
